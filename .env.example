# .env.example
DB_USERNAME=your_username_here
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_DATABASE=school_db
# Used only by `python manage.py db upgrade`; do not run the web app with this account.
DB_MIGRATION_USERNAME=school_migrator
DB_MIGRATION_PASSWORD=replace-with-a-dedicated-migration-account-password
SECRET_KEY=replace-with-a-unique-random-value
FLASK_DEBUG=false